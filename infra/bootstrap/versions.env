# Pinned versions for infra/bootstrap and the ops scripts. One NAME_VERSION plus one NAME_SHA256_<amd64|arm64> per
# artifact (the same value twice for arch-independent files); every sha256 comes from the vendor's published checksum
# (exceptions noted inline) and is verified (sha256sum -c) before use. Sourced by shell scripts: plain KEY=value lines only.

# kubeseal CLI (scripts/seal-secrets.sh); sealed-secrets_0.41.2_checksums.txt
KUBESEAL_VERSION=0.41.2
KUBESEAL_SHA256_amd64=666b5db6788ad1dedb56e2d97064e1cc3779aa77bbd6f4b56b62beeb1941ed79
KUBESEAL_SHA256_arm64=8a73c0b252f6c0e8752a7a749da51f55a6e99dc5603e3bd29ed3c00ff9e82db2

# k3s (stable channel, update.k3s.io/v1-release/channels/stable); binaries `k3s` / `k3s-arm64` from the release,
# sha256 from the release's sha256sum-amd64.txt / sha256sum-arm64.txt
K3S_VERSION=v1.37.2+k3s1
K3S_SHA256_amd64=265b3ee6a3198ef14033c63ef46cbb32370d83795199fb6d1b01f21575eddbda
K3S_SHA256_arm64=a779ccf1e5e2e33a62f5a29c2f1c0bbf99431e100579d4c10f0aa0742a6aa84b
# k3s install.sh from the same tag (arch-independent); sha256 from install.sh.sha256sum at that tag
K3S_INSTALL_VERSION=v1.37.2+k3s1
K3S_INSTALL_SHA256_amd64=ed01f89fd977bf20ac1516bbebf8370bf3ddbaa55dac8aba610956a4c78cc00b
K3S_INSTALL_SHA256_arm64=ed01f89fd977bf20ac1516bbebf8370bf3ddbaa55dac8aba610956a4c78cc00b

# Tailscale static tarball (pkgs.tailscale.com/stable); sha256 from the published tailscale_<v>_<arch>.tgz.sha256
TAILSCALE_VERSION=1.104.7
TAILSCALE_SHA256_amd64=e56693ff74a64f2591b7e819c280635a100aae1ddfb0ef058fcd052b7cd8d16c
TAILSCALE_SHA256_arm64=d6bed2720310b328b861f943d7b4016c5358a9bad60575eb51e8143b79068484

# Sealed Secrets controller.yaml release asset (arch-independent; the image is multi-arch). The vendor checksums file
# covers only kubeseal, so this is the sha256 digest GitHub publishes for the release asset.
SEALED_SECRETS_VERSION=0.41.2
SEALED_SECRETS_SHA256_amd64=5973b18ef77ae91e464bac62542a12c48844a08da69d80e45a8fc7f0d67fe205
SEALED_SECRETS_SHA256_arm64=5973b18ef77ae91e464bac62542a12c48844a08da69d80e45a8fc7f0d67fe205

# Argo CD manifests/install.yaml (arch-independent; images multi-arch). Argo CD publishes no checksum for it (only
# cli_checksums.txt), so it is fetched by the tag's commit (immutable) and this sha256 is of that file at that commit.
ARGOCD_VERSION=v3.6.3
ARGOCD_COMMIT=b4accc482028fd529b3e4508ef9f28977b552b50
ARGOCD_SHA256_amd64=22b404352546b3bd000cd8354de793e8ca748fc8f3b2798cefe397dc4cafef27
ARGOCD_SHA256_arm64=22b404352546b3bd000cd8354de793e8ca748fc8f3b2798cefe397dc4cafef27
