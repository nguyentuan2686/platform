{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.dev/contracts/events/order-placed.v1.schema.json",
  "title": "OrderPlaced v1",
  "description": "Envelope published to topic orders.order-placed.v1 (key = order id).",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "data"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "OrderPlaced" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "required": ["order_id", "customer_id", "total", "item_count"],
      "properties": {
        "order_id": { "type": "string", "format": "uuid" },
        "customer_id": { "type": "string", "minLength": 1 },
        "total": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "item_count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true,
      "$comment": "Open for additive v1 changes: consumers must ignore unknown data fields. Breaking changes go to a new topic orders.order-placed.v2."
    }
  },
  "additionalProperties": false
}
