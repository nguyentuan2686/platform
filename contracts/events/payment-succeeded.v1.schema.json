{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.dev/contracts/events/payment-succeeded.v1.schema.json",
  "title": "PaymentSucceeded v1",
  "description": "Envelope published to topic payments.payment-succeeded.v1 (key = account_id). Consumed by identity-svc (grants credits or a pass, idempotent on event_id and on data.order_id) and notify-svc (revenue + a Telegram message to the owner, idempotent on event_id and on data.order_id; reads order_id, product_code, amount, currency, paid_at).",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "data"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "PaymentSucceeded" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "required": [
        "order_id",
        "order_code",
        "account_id",
        "product_code",
        "site",
        "amount",
        "currency",
        "provider",
        "paid_at"
      ],
      "properties": {
        "order_id": { "type": "string", "format": "uuid" },
        "order_code": { "type": "string", "minLength": 1 },
        "account_id": { "type": "string", "format": "uuid" },
        "product_code": { "enum": ["CREDIT_1", "CREDIT_5", "PASS_MONTH", "PASS_YEAR"] },
        "site": { "enum": ["tuvi", "astro"] },
        "amount": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "currency": { "enum": ["VND", "USD"] },
        "provider": { "enum": ["SEPAY", "PAYPAL"] },
        "paid_at": { "type": "string", "format": "date-time" },
        "chart_profile_id": { "type": ["string", "null"], "format": "uuid" }
      },
      "additionalProperties": true,
      "$comment": "Open for additive v1 changes: consumers must ignore unknown data fields. Breaking changes go to a new topic payments.payment-succeeded.v2."
    }
  },
  "additionalProperties": false
}
