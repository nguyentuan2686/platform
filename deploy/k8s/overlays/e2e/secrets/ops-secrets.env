# Test values only. MinIO (minio.yaml) takes its root credentials from S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY.
S3_ENDPOINT=http://minio.data.svc.cluster.local:9000
S3_BUCKET=pg-backups
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=local-test-minio
S3_SECRET_ACCESS_KEY=local-test-minio-secret
HEALTHCHECKS_URL=http://minio.data.svc.cluster.local:9000/minio/health/live
HEALTHCHECKS_BACKUP_URL=
