# Dev-only values. Compose has the same defaults, so copying to .env is optional.
# The same test values (as k8s e2e Secrets) live in deploy/k8s/overlays/e2e/secrets/*.env; keep them in sync.
POSTGRES_PASSWORD=postgres
DB_USER=orders
DB_PASSWORD=orders
ORDER_SVC_PORT=8080
NOTIFY_DB_USER=notify
NOTIFY_DB_PASSWORD=notify
NOTIFY_SVC_PORT=8081
# Rust services (notify-svc, chart-svc) default to a quiet filter (info; exporter stack at warn).
# Setting RUST_LOG in a service environment replaces that default filter entirely.

# ---- identity-svc / payment-svc (F1.3) ----
# Test values only; real ones come from Sealed Secrets. All optional: compose defaults to these.
INTERNAL_API_TOKEN=local-test-internal-token
ADMIN_API_TOKEN=local-test-admin-token
IDENTITY_SVC_PORT=8084
PAYMENT_SVC_PORT=8085

# identity-svc
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=identity
# base64 of the 32-byte test phrase "local-test-profile-key-012345678" (AES-256 key)
PROFILE_ENC_KEY=bG9jYWwtdGVzdC1wcm9maWxlLWtleS0wMTIzNDU2Nzg=
WEB_BASE_URL=http://localhost:3001
MAIL_FROM=no-reply@localhost
# Google login is off locally: leave the client id empty.
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_REDIRECT_URIS=

# payment-svc
PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=payment
SEPAY_WEBHOOK_AUTH=apikey
SEPAY_WEBHOOK_SECRET=local-test-sepay-secret
SEPAY_BANK_CODE=TEST BANK
SEPAY_ACCOUNT_NUMBER=0000000000
SEPAY_ACCOUNT_NAME=TEST BANK
PAYPAL_FAKE_WEBHOOK_SECRET=local-test-paypal-secret

# ---- reading-tuvi Q&A + LLM gateway (F1.4) ----
# INTERNAL_API_TOKEN above is shared with reading-tuvi. Local runs use the fake provider only.
# base64 of the 32-byte test phrase "local-test-qa-answer-key-0123456" (AES-256 key)
QA_ENC_KEY=bG9jYWwtdGVzdC1xYS1hbnN3ZXIta2V5LTAxMjM0NTY=
# HMAC key of the xem-số quota table (at least 16 characters)
NUMBER_CHECK_HMAC_KEY=local-test-number-check-hmac-key
LLM_PROVIDERS=fake
# With real keys (your shell only): LLM_PROVIDERS=claude,groq,gemini (order = failover order).
# ok | fail | unsafe  (fail = the retry/refund drill, see docs/runbooks/llm-gateway.md)
LLM_FAKE_MODE=ok
QA_JOBS_ENABLED=true
QA_JOB_INTERVAL=PT1M
# Real provider keys: set only via Sealed Secrets / your shell, never commit. Leave empty locally.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- web (F1.5b) ----
# ADMIN_API_TOKEN and SEPAY_WEBHOOK_* above are shared with web (server-side only).
# Comma list of account UUIDs allowed on /vi/quan-tri (the "chưa khớp" page); empty = nobody.
ADMIN_ACCOUNT_IDS=
# The dev "giả lập chuyển khoản" button is on in compose (DEV_PAYMENT_SIMULATOR=1, DEPLOY_ENV=local);
# DEPLOY_ENV=prod always disables it.
# Public origin of the site. Baked into static pages at build (compose build arg) and used for the
# same-origin check at runtime. Set it to the public domain when Plan 4 deploys.
WEB_ORIGIN=http://localhost:3001
WEB_PORT=3001
QA_STREAM_TIMEOUT_MS=95000
# NEVER set DEV_PAYMENT_SIMULATOR in production (compose hard-codes it to 1 for the local stack only).
